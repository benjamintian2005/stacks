# Neon Postgres (provisioned via Vercel Marketplace: vercel integration add neon)
DATABASE_URL=

# Clerk (provisioned via Vercel Marketplace: vercel integration add clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Media metadata APIs
TMDB_API_KEY=
RAWG_API_KEY=
GOOGLE_BOOKS_API_KEY=
# MusicBrainz and Jikan work keyless — no key needed. Google Books also works keyless at low
# volume, but shared serverless IPs (Vercel, etc.) burn through that quota fast — add a free
# key from https://console.cloud.google.com/apis/library/books.googleapis.com for reliability.
