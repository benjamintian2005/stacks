generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActivityEventType {
  LOGGED_EXPERIENCE
  FOLLOWED_USER
}

/// Keyed by Clerk user id — no separate "account" model needed.
model Profile {
  id          String   @id
  username    String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  bannerUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  experiences    Experience[]
  activityEvents ActivityEvent[] @relation("ActorEvents")
  likes          Like[]
  comments       Comment[]
  following      Follow[]        @relation("Follower")
  followers      Follow[]        @relation("Following")
}

/// A logged real-world experience: something the user did, with optional photos.
model Experience {
  id            String   @id @default(cuid())
  userId        String
  user          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  location      String?
  experiencedAt DateTime
  createdAt     DateTime @default(now())

  photos   ExperiencePhoto[]
  likes    Like[]
  comments Comment[]

  @@index([userId, experiencedAt])
}

model ExperiencePhoto {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  url          String
  position     Int        @default(0)

  @@index([experienceId])
}

model Follow {
  followerId  String
  follower    Profile  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   Profile  @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model ActivityEvent {
  id           String            @id @default(cuid())
  actorId      String
  actor        Profile           @relation("ActorEvents", fields: [actorId], references: [id], onDelete: Cascade)
  eventType    ActivityEventType
  experienceId String?
  targetUserId String?
  createdAt    DateTime          @default(now())

  @@index([actorId, createdAt])
}

model Like {
  userId       String
  user         Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, experienceId])
}

model Comment {
  id           String     @id @default(cuid())
  userId       String
  user         Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  text         String
  createdAt    DateTime   @default(now())

  @@index([experienceId])
}
